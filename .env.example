# Email alert configuration (optional — leave blank to disable email alerts)
ALERT_EMAIL_SENDER=your.team@gmail.com
ALERT_EMAIL_PASSWORD=your-app-specific-password
ALERT_EMAIL_RECIPIENT=demo.recipient@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Flask API configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
